{
  "_说明": [
    "这份文件会被自动生成到 ~/.dsh/dsh-memory/config.json。",
    "最省事的路：只填 workspaces 一个字段，让它跑起来。",
    "enabled=false 或 workspaces 为空时，插件什么都不做。"
  ],
  "enabled": true,

  "workspaces": [
    "D:\\your-workspace"
  ],

