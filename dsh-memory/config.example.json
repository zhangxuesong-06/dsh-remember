  "anchorChars": 120,

  "arrival": true,
  "arrivalChars": 2400,

  "facts": true,
  "factMax": 8,

  "recallMaxChars": 2200,

  "_时间衰减说明": "t0 拐点（天）· alpha 尾巴厚度 · floor 地板。默认是标定过的，别随手改。",
